---
import "../styles/global.css";
import type { Proposal } from "../data/proposals";

interface Props {
  proposal: Proposal;
}

const { proposal } = Astro.props;

const pageTitle = `${proposal.title} — ${proposal.client} | Made in Greene`;

// Parsed as UTC so the date never shifts a day depending on the viewer's timezone.
const validThrough = new Date(`${proposal.validThrough}T00:00:00Z`);
const validThroughLabel = validThrough.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

// Table of contents, grouped by the `part` label on each section.
const toc: { part: string; sections: { id: string; title: string }[] }[] = [];
for (const section of proposal.sections) {
  const part = section.part ?? "";
  const group = toc.at(-1);
  if (group && group.part === part) {
    group.sections.push({ id: section.id, title: section.title });
  } else {
    toc.push({ part, sections: [{ id: section.id, title: section.title }] });
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta
      name="description"
      content={`Website proposal and service agreement prepared for ${proposal.client}.`}
    />
    <!-- Client-confidential: never indexed, never linked from the site, excluded from the sitemap. -->
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700;9..144,800;9..144,900&family=Figtree:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      /* ---- Print / Save-as-PDF ---- */
      @page {
        size: letter;
        margin: 0.7in 0.65in 0.85in;
      }

      @media print {
        html,
        body {
          background: #fff !important;
          font-size: 10pt;
        }

        /* Tighter vertical rhythm on paper than on screen — the generous screen
           spacing costs several extra sheets. */
        section h2 {
          margin-top: 1.5rem !important;
          margin-bottom: 0.6rem !important;
        }

        section h3 {
          margin-top: 1rem !important;
          margin-bottom: 0.35rem !important;
        }

        section p {
          margin-bottom: 0.5rem !important;
        }

        section ul,
        section ol,
        section table {
          margin-top: 0.5rem !important;
          margin-bottom: 0.5rem !important;
        }

        section li {
          line-height: 1.4;
        }

        /* Print width is narrower than the `md` breakpoint, so the signature
           parties would stack and split across sheets. Keep them side by side. */
        .sig-grid {
          grid-template-columns: 1fr 1fr !important;
          gap: 1.25rem !important;
          break-inside: avoid;
        }

        .no-print {
          display: none !important;
        }

        .print-only {
          display: block !important;
        }

        /* Repeats at the foot of every printed sheet in Chrome/Safari. Sits inside
           the page's bottom margin, which body padding keeps clear of content. */
        body {
          padding-bottom: 0.3in;
        }

        .print-footer {
          position: fixed;
          bottom: 0;
          left: 0;
          right: 0;
          font-size: 8pt;
          color: #756f65;
          border-top: 1px solid #d1cbc0;
          padding-top: 5px;
          display: flex !important;
          justify-content: space-between;
        }

        .page-break {
          break-before: page;
        }

        /* Keep headings attached to the text beneath them. */
        h1,
        h2,
        h3,
        h4 {
          break-after: avoid;
          break-inside: avoid;
        }

        p,
        li,
        tr {
          break-inside: avoid;
        }

        table {
          width: 100% !important;
          min-width: 0 !important;
        }

        /* Force the branded table headers to print — otherwise white-on-white. */
        thead tr {
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
          background: #174932 !important;
        }

        thead th {
          color: #fff !important;
        }

        /* The cover prints as a clean white title page, not a full-bleed green block. */
        .cover {
          background: #fff !important;
          break-after: page;
          padding-top: 0.5in;
        }

        .cover,
        .cover * {
          color: #1c1917 !important;
          border-color: #d1cbc0 !important;
        }

        .cover .on-accent {
          color: #3d7a1c !important;
        }

        .cover .on-price {
          color: #174932 !important;
        }

        .cover .panel {
          background: transparent !important;
          border: 1px solid #d1cbc0 !important;
        }

        a {
          color: inherit;
          text-decoration: none;
        }
      }

      .print-only {
        display: none;
      }

      /* Offsets anchor jumps so section titles clear the sticky bar. */
      [id] {
        scroll-margin-top: 5.5rem;
      }
    </style>
  </head>

  <body class="bg-cream text-warm-800">
    <!-- Expiry notice — shown only when the proposal date has passed. -->
    <div
      id="expiry-banner"
      hidden
      class="no-print bg-accent text-warm-900 text-center text-sm font-medium px-4 py-2.5"
    >
      This proposal passed its validity date of {validThroughLabel}. Pricing and
      availability may have changed — please
      <a href={`mailto:${proposal.preparedBy.email}`} class="underline font-semibold">get in touch</a>
      for a current version.
    </div>

    <!-- Sticky utility bar -->
    <div
      class="no-print sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-warm-200"
    >
      <div class="max-w-6xl mx-auto px-5 sm:px-6 h-14 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3 min-w-0">
          <img src="/made-in-greene-logo.svg" alt="" class="h-7 w-auto shrink-0" />
          <span class="text-sm text-warm-600 truncate hidden sm:block">
            Proposal for <span class="font-semibold text-warm-900">{proposal.client}</span>
          </span>
        </div>
        <button
          type="button"
          data-print
          class="shrink-0 inline-flex items-center gap-2 rounded-lg bg-primary px-3.5 py-2 text-sm font-semibold text-white hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          Print / Save PDF
        </button>
      </div>
    </div>

    <!-- Cover -->
    <header class="cover bg-primary-dark text-white">
      <div class="max-w-6xl mx-auto px-5 sm:px-6 py-14 md:py-20 text-center">
        <img
          src="/made-in-greene-logo.svg"
          alt="Made in Greene"
          class="h-20 md:h-24 w-auto mx-auto mb-10 brightness-0 invert print:brightness-100 print:invert-0"
        />
        <p class="on-accent text-accent font-semibold text-xs sm:text-sm uppercase tracking-[0.18em] mb-4">
          {proposal.eyebrow}
        </p>
        <h1 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold leading-tight max-w-3xl mx-auto">
          {proposal.title}
        </h1>

        {proposal.demoUrl && (
          <p class="mt-6 text-sm">
            <span class="text-white/60">Demo:</span>{" "}
            <a href={proposal.demoUrl} class="text-accent-light underline underline-offset-4 break-all">
              {proposal.demoUrl.replace(/^https?:\/\//, "")}
            </a>
          </p>
        )}

        <div class="mt-10 grid gap-6 sm:grid-cols-2 max-w-2xl mx-auto text-left">
          <div class="panel rounded-xl bg-white/10 p-5">
            <p class="on-accent text-xs uppercase tracking-wider text-accent font-semibold mb-2">Prepared For</p>
            <p class="font-display text-xl font-bold">{proposal.client}</p>
          </div>
          <div class="panel rounded-xl bg-white/10 p-5">
            <p class="on-accent text-xs uppercase tracking-wider text-accent font-semibold mb-2">Prepared By</p>
            <p class="font-semibold">{proposal.preparedBy.name}</p>
            <p class="text-white/80 text-sm">{proposal.preparedBy.company}</p>
            <a
              href={`mailto:${proposal.preparedBy.email}`}
              class="text-white/80 text-sm underline underline-offset-2 hover:text-white break-all"
            >
              {proposal.preparedBy.email}
            </a>
          </div>
        </div>

        <div class="mt-10 pt-8 border-t border-white/20 max-w-2xl mx-auto">
          <p class="on-price font-display text-4xl md:text-5xl font-bold text-accent">{proposal.price}</p>
          <p class="text-white/80 text-sm font-medium mt-1">{proposal.priceNote}</p>
          <p class="text-white/60 text-xs mt-5">Proposal valid through {validThroughLabel}</p>
        </div>
      </div>
    </header>

    <div class="max-w-6xl mx-auto px-5 sm:px-6 py-12 md:py-16">
      <div class="lg:grid lg:grid-cols-[15rem_1fr] lg:gap-12">
        <!-- Contents: sidebar on desktop, collapsible on mobile -->
        <nav aria-label="Contents" class="no-print mb-10 lg:mb-0">
          <div class="lg:sticky lg:top-20">
            <details class="lg:hidden rounded-xl border border-warm-200 bg-white px-4 py-3">
              <summary class="cursor-pointer font-semibold text-warm-900 text-sm">Contents</summary>
              <div class="mt-3">
                {toc.map((group) => (
                  <div class="mb-4 last:mb-0">
                    {group.part && (
                      <p class="text-[0.7rem] uppercase tracking-wider text-warm-500 font-semibold mb-1.5">
                        {group.part}
                      </p>
                    )}
                    <ul class="space-y-1.5">
                      {group.sections.map((s) => (
                        <li>
                          <a href={`#${s.id}`} class="text-sm text-warm-700 hover:text-primary">
                            {s.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </details>

            <div class="hidden lg:block">
              <p class="text-xs uppercase tracking-wider text-warm-500 font-semibold mb-4">
                Contents
              </p>
              {toc.map((group) => (
                <div class="mb-5 last:mb-0">
                  {group.part && (
                    <p class="text-[0.7rem] uppercase tracking-wider text-primary font-semibold mb-1.5">
                      {group.part}
                    </p>
                  )}
                  <ul class="space-y-1.5 border-l border-warm-200">
                    {group.sections.map((s) => (
                      <li>
                        <a
                          href={`#${s.id}`}
                          data-toc-link
                          class="block border-l-2 border-transparent -ml-px pl-3 py-0.5 text-sm text-warm-600 hover:text-primary hover:border-primary-light transition-colors"
                        >
                          {s.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </nav>

        <article class="min-w-0">
          <slot />
        </article>
      </div>
    </div>

    <footer class="no-print bg-warm-100 border-t border-warm-200">
      <div class="max-w-6xl mx-auto px-5 sm:px-6 py-8 text-center text-sm text-warm-600">
        <p class="font-semibold text-warm-900">Made in Greene</p>
        <p class="mt-1">
          Greene County, Tennessee ·
          <a href={`mailto:${proposal.preparedBy.email}`} class="underline hover:text-primary">
            {proposal.preparedBy.email}
          </a>
        </p>
        <p class="mt-3 text-xs text-warm-500">
          Confidential — prepared for {proposal.client}. Proposal valid through {validThroughLabel}.
        </p>
      </div>
    </footer>

    <!-- Repeats on every printed page -->
    <div class="print-only print-footer">
      <span>Made in Greene | Greene County, Tennessee | {proposal.preparedBy.email}</span>
      <span>{proposal.client}</span>
    </div>

    <script is:inline define:vars={{ validThrough: proposal.validThrough }}>
      // Print button
      document.querySelectorAll("[data-print]").forEach((btn) => {
        btn.addEventListener("click", () => window.print());
      });

      // Expiry banner — evaluated on view, not at build time. Valid through the
      // end of the stated day in the viewer's local time.
      const expires = new Date(`${validThrough}T23:59:59`);
      if (!Number.isNaN(expires.valueOf()) && Date.now() > expires.valueOf()) {
        document.getElementById("expiry-banner")?.removeAttribute("hidden");
      }

      // Highlight the section currently in view in the sidebar contents.
      const links = [...document.querySelectorAll("[data-toc-link]")];
      const active = "text-primary font-semibold border-primary".split(" ");
      const targets = links
        .map((link) => document.querySelector(link.getAttribute("href")))
        .filter(Boolean);

      if (targets.length > 0 && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const link = links.find(
                (l) => l.getAttribute("href") === `#${entry.target.id}`,
              );
              if (!link) return;
              if (entry.isIntersecting) {
                links.forEach((l) => l.classList.remove(...active));
                link.classList.add(...active);
              }
            });
          },
          { rootMargin: "-20% 0px -70% 0px" },
        );
        targets.forEach((t) => observer.observe(t));
      }
    </script>
  </body>
</html>
