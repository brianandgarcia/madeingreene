---
import { publishedPosts, formatPostDate, readingTime } from "../data/posts";

// Newest three posts for the homepage teaser.
const latest = publishedPosts.slice(0, 3);
---

{latest.length > 0 && (
  <section class="py-20 md:py-28 bg-warm-100 border-t border-warm-200 overflow-hidden">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10" data-reveal>
        <div>
          <span class="text-primary font-semibold text-sm uppercase tracking-wider">News &amp; Notes</span>
          <h2 class="text-3xl md:text-4xl font-bold text-dark mt-3 mb-3">
            The latest from Made in Greene
          </h2>
          <p class="text-warm-500 max-w-xl">
            Company news, a look at how we build, and honest advice for getting your local business
            online.
          </p>
        </div>
        <a
          href="/blog"
          class="inline-flex items-center text-primary font-semibold hover:text-primary-dark transition-colors shrink-0"
        >
          Read the Blog
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {latest.map((post, i) => (
          <a
            href={`/blog/${post.slug}`}
            class="group flex flex-col bg-white rounded-2xl overflow-hidden border border-warm-200 hover:border-primary/40 hover:shadow-lg hover:shadow-primary/5 transition-all"
            data-reveal
            style={`--reveal-delay: ${i * 100}ms`}
          >
            {post.cover && (
              <div class="relative aspect-[16/9] overflow-hidden bg-warm-100">
                <img
                  src={post.cover}
                  alt=""
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500"
                />
              </div>
            )}
            <div class="p-6 flex flex-col flex-1">
              <span class="inline-flex self-start items-center rounded-full bg-primary/10 px-3 py-1 text-[11px] font-semibold text-primary-dark uppercase tracking-wide mb-3">
                {post.category}
              </span>
              <h3 class="text-lg font-bold text-dark leading-snug mb-2 group-hover:text-primary transition-colors">
                {post.title}
              </h3>
              <p class="text-warm-500 text-sm leading-relaxed mb-5 flex-1 line-clamp-3">{post.excerpt}</p>
              <div class="flex items-center gap-3 text-xs text-warm-500 mt-auto">
                <span>{formatPostDate(post.date)}</span>
                <span class="w-1 h-1 rounded-full bg-warm-300"></span>
                <span>{readingTime(post)} min read</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
