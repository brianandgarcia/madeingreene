---
/*
  Paid marketing services (Google Business Profile and Google Ads), shared by
  What We Offer (dark), Small Business (light) and the homepage (teaser).
  Copy lives in src/data/services.ts.
*/
import { found } from "../data/services";

interface Props {
  tone?: "dark" | "light";
  variant?: "full" | "teaser";
  showNote?: boolean;
  id?: string;
}
const { tone = "dark", variant = "full", showNote = true, id = "found" } = Astro.props;
const dark = tone === "dark";
---

{variant === "teaser" ? (
  <section id={id} class="py-24 md:py-32 bg-white border-t border-warm-200 scroll-mt-24">
    <div class="max-w-6xl mx-auto px-6 grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20 items-start">
      <div data-reveal>
        <span class="text-primary font-semibold text-sm uppercase tracking-wider">{found.eyebrow}</span>
        <h2 class="mt-3 text-3xl md:text-5xl font-bold text-dark leading-[1.05] text-balance">{found.teaser.title}</h2>
        <p class="mt-5 text-lg text-warm-700 leading-relaxed">{found.teaser.body}</p>
        <a href={found.teaser.link.href} class="mt-8 inline-flex items-center gap-2 font-semibold text-primary hover:text-primary-dark underline underline-offset-4">
          {found.teaser.link.label} <span aria-hidden="true">→</span>
        </a>
      </div>
      <dl class="border-t-2 border-dark" data-reveal>
        {found.services.map((svc) => (
          <div class="py-6 border-b border-warm-300 grid gap-1 sm:grid-cols-[1fr_auto] sm:gap-x-8">
            <dt class="font-display text-xl font-bold text-dark">{svc.name}</dt>
            <dd class="sm:row-span-2 sm:text-right font-semibold text-primary-dark whitespace-nowrap">{svc.short}</dd>
            <dd class="text-warm-700 leading-relaxed">{svc.summary}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
) : (
  <section id={id} class:list={["py-24 md:py-36 scroll-mt-24", dark ? "bg-primary-dark text-white" : "bg-white border-y border-warm-200"]}>
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl">
        <span class:list={["font-semibold text-sm uppercase tracking-wider", dark ? "text-primary-light" : "text-primary"]}>{found.eyebrow}</span>
        <h2 class:list={["mt-3 text-3xl md:text-5xl font-bold leading-[1.05]", !dark && "text-dark"]}>{found.title}</h2>
        <p class:list={["mt-5 text-lg leading-relaxed", dark ? "text-white/75" : "text-warm-700"]}>{found.body}</p>
      </div>
      <div class:list={["mt-12 border-t", dark ? "border-white/15" : "border-warm-300"]}>
        {found.services.map((svc) => (
          <article class:list={["grid gap-3 py-8 border-b md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] md:gap-12", dark ? "border-white/15" : "border-warm-300"]}>
            <div>
              <h3 class:list={["text-xl md:text-2xl font-bold", !dark && "text-dark"]}>{svc.name}</h3>
              <p class:list={["mt-2 font-semibold leading-snug", dark ? "text-accent" : "text-primary-dark"]}>{svc.price}</p>
            </div>
            <p class:list={["leading-relaxed", dark ? "text-white/85" : "text-warm-700"]}>{svc.text}</p>
          </article>
        ))}
      </div>
      {showNote && (
        <p class:list={["mt-8 pl-4 border-l-2 border-accent leading-relaxed max-w-3xl", dark ? "text-white/85" : "text-warm-700"]}>{found.note}</p>
      )}
    </div>
  </section>
)}
