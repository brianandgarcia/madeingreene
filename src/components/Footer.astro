---
const currentYear = new Date().getFullYear();
---

<footer class="bg-dark text-warm-400">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      <div class="md:col-span-2">
        <a href="/" class="inline-flex items-center mb-4" aria-label="Made in Greene — home">
          <img src="/made-in-greene-logo.svg" alt="Made in Greene" class="h-14 w-auto brightness-0 invert opacity-90" />
        </a>
        <p class="text-sm leading-relaxed max-w-sm">
          Affordable websites for Greene County businesses.
          Clear pricing. Local support. No runaround.
        </p>
        <p class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-white/90">
          <svg class="w-4 h-4 text-primary-light shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Member of the Greene County Partnership
        </p>
      </div>

      <div>
        <h3 class="text-white font-semibold mb-4 text-sm uppercase tracking-wider">Navigation</h3>
        <ul class="space-y-2">
          <li><a href="/" class="text-sm hover:text-primary transition-colors">Home</a></li>
          <li><a href="/services" class="text-sm hover:text-primary transition-colors">Services</a></li>
          <li><a href="/work" class="text-sm hover:text-primary transition-colors">Work</a></li>
          <li><a href="/blog" class="text-sm hover:text-primary transition-colors">Blog</a></li>
          <li><a href="/why-not-other-providers" class="text-sm hover:text-primary transition-colors">Why Not Other Providers</a></li>
          <li><a href="/about" class="text-sm hover:text-primary transition-colors">About</a></li>
          <li><a href="/contact" class="text-sm hover:text-primary transition-colors">Contact</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-white font-semibold mb-4 text-sm uppercase tracking-wider">Contact</h3>
        <ul class="space-y-2 text-sm">
          <li>Greene County, TN</li>
          <li>
            <a href="mailto:brian@madeingreene.com" class="hover:text-primary transition-colors">
              brian@madeingreene.com
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-warm-800 mt-12 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs">
        &copy; {currentYear} Made in Greene. All rights reserved.
      </p>
      <p class="text-xs inline-flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-primary-light shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
        Built to WCAG 2.1 AA
      </p>
      <p class="text-xs">
        Proudly built in Greene County, Tennessee.
      </p>
    </div>
  </div>
</footer>
