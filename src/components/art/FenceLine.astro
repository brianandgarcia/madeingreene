---
/*
  The Greene County horizon: one hand-drawn line of mountains, hills, a barn
  and silo, grazing cattle, power poles, a water tower, a sawtooth-roof plant,
  a box truck and grain bins. Everything is stroked in currentColor, so the
  parent sets the colour. The power lines carry a gold "signal", the same idea
  as the systems map: farm and factory, wired together.

  Ground line is y = 200 in a 1600 × 220 box.
*/
interface Props {
  class?: string;
  /** Run the signal along the power lines (off under reduced motion). */
  animate?: boolean;
  /** How to crop on narrow screens: keep the middle, or the left/right end. */
  align?: "mid" | "min" | "max";
}
const { class: className = "", animate = true, align = "mid" } = Astro.props;
const par = `x${align[0].toUpperCase()}${align.slice(1)}YMax slice`;

const G = 200; // ground

// Power poles and the sagging lines between them.
const poles = [262, 520, 790, 1060, 1355];
const poleTop = 92;
const spans = poles.slice(1).map((x, i) => {
  const a = poles[i];
  const mid = (a + x) / 2;
  return [
    `M${a - 10} ${poleTop + 4} Q${mid} ${poleTop + 26} ${x - 10} ${poleTop + 4}`,
    `M${a + 10} ${poleTop + 4} Q${mid} ${poleTop + 30} ${x + 10} ${poleTop + 4}`,
  ];
});

// Fence posts and rails.
const fence = (from: number, to: number, step = 26) => {
  const posts: number[] = [];
  for (let x = from; x <= to; x += step) posts.push(x);
  return {
    posts: posts.map((x) => `M${x} ${G} V${G - 22}`).join(" "),
    rails: `M${from} ${G - 17} H${to} M${from} ${G - 8} H${to}`,
  };
};
const fenceA = fence(236, 300);
const fenceA2 = fence(608, 660);
const fenceB = fence(1450, 1600);

// A grazing cow, 90 wide, hooves on y = 56.
const cow =
  "M24 14 C40 10 58 10 70 11 C77 12 80 18 78 26 C77 32 76 36 72 38 L30 38 C25 38 22 34 22 28 " + // body
  "M24 14 C16 16 12 22 10 30 L7 40 C6 45 9 48 13 47 C16 46 17 43 16 40 L20 30 " + // neck and head, grazing
  "M14 26 L8 23 M16 22 L14 17 " + // ear and horn
  "M26 37 V56 M32 38 V56 M66 38 V56 M72 37 V56 " + // legs
  "M58 38 C58 42 62 42 62 38 " + // udder
  "M78 18 C82 24 82 34 80 42 M80 42 L78 46 M80 42 L82 46"; // tail
const cowSpots =
  "M40 13 C48 12 52 18 49 24 C46 29 39 27 38 22 Z M60 22 C65 21 68 25 66 29 C63 32 58 30 58 26 Z M30 22 C33 21 35 24 33 27 C31 28 29 26 30 22 Z";
---

<svg
  class:list={["fence-line", animate && "fence-line--live", className]}
  viewBox="0 0 1600 220"
  preserveAspectRatio={par}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <!-- The Bald Mountains, far off -->
  <path opacity="0.35" d="M0 150 L70 128 L120 140 L190 104 L250 132 L330 96 L400 126 L470 112 L540 138 L640 100 L720 130 L800 118 L880 142 L980 108 L1060 134 L1150 96 L1230 128 L1300 116 L1380 140 L1470 106 L1540 130 L1600 120" />
  <!-- Rolling hills -->
  <path opacity="0.4" d="M0 178 C120 160 220 168 330 176 S560 158 700 170 S940 182 1080 168 S1330 156 1460 172 S1560 176 1600 170" />
  <!-- Ground -->
  <path d={`M0 ${G} H1600`} />

  <!-- Trees -->
  <g>
    <path d="M60 200 V172 M60 178 L50 168 M60 182 L70 172" />
    <path d="M60 172 C40 172 34 150 46 140 C44 124 64 116 72 128 C88 124 92 146 82 156 C86 168 74 174 60 172 Z" />
    <path d="M860 200 V176" />
    <path d="M860 176 C846 176 842 160 850 152 C850 140 868 136 872 148 C882 150 882 166 872 172 C870 176 866 176 860 176 Z" />
    <path d="M1520 200 V170" />
    <path d="M1520 170 C1500 170 1496 150 1508 142 C1506 128 1526 122 1532 134 C1546 132 1548 152 1538 160 C1540 168 1532 172 1520 170 Z" />
  </g>

  <!-- Barn and silo -->
  <g transform={`translate(104 ${G - 92}) scale(1.3)`}>
    <path d="M10 70 V30 H80 V70" />
    <path d="M5 32 L18 14 L45 4 L72 14 L85 32" />
    <path d="M33 70 V46 H57 V70 M33 46 L57 70 M57 46 L33 70" />
    <path d="M40 18 H50 V28 H40 Z" />
    <path d="M92 70 V20 A10 10 0 0 1 112 20 V70 M92 32 H112 M92 46 H112 M92 58 H112" />
  </g>

  <!-- Fence and cattle -->
  <path d={fenceA.posts} />
  <path d={fenceA.rails} opacity="0.7" />
  <path d={fenceA2.posts} />
  <path d={fenceA2.rails} opacity="0.7" />
  <g transform={`translate(310 ${G - 56})`}><path d={cow} /><path d={cowSpots} fill="currentColor" stroke="none" opacity="0.85" /></g>
  <g transform={`translate(410 ${G - 51}) scale(0.9)`}><path d={cow} /><path d={cowSpots} fill="currentColor" stroke="none" opacity="0.85" /></g>
  <g transform={`translate(594 ${G - 56}) scale(-1 1)`}><path d={cow} /><path d={cowSpots} fill="currentColor" stroke="none" opacity="0.85" /></g>

  <!-- Round hay bales -->
  <g>
    <circle cx="684" cy={G - 13} r="13" />
    <circle cx="684" cy={G - 13} r="5" opacity="0.6" />
    <circle cx="716" cy={G - 11} r="4" opacity="0.6" />
    <circle cx="716" cy={G - 11} r="11" />
  </g>

  <!-- Water tower -->
  <g transform={`translate(890 ${G - 112})`}>
    <path d="M6 20 L30 4 L54 20" />
    <rect x="8" y="18" width="44" height="28" rx="10" />
    <path d="M14 46 L6 112 M46 46 L54 112 M24 46 L22 112 M36 46 L38 112 M10 76 L50 76 M9 92 L51 92 M10 76 L51 92 M50 76 L9 92" />
  </g>

  <!-- Sawtooth-roof plant with stack -->
  <g transform={`translate(985 ${G - 99}) scale(1.1)`}>
    <path d="M0 90 V40 M0 22 L40 40 V22 L80 40 V22 L120 40 V22 L160 40 V22 L200 40 V22 L240 40 V90 M0 40 V22" />
    <path d="M0 40 H240" opacity="0.6" />
    <path d="M14 54 h14 v10 h-14 z M40 54 h14 v10 h-14 z M66 54 h14 v10 h-14 z M92 54 h14 v10 h-14 z M118 54 h14 v10 h-14 z M144 54 h14 v10 h-14 z" />
    <path d="M190 90 V60 H222 V90 M190 67 H222 M190 74 H222 M190 81 H222" />
    <path d="M252 90 V0 H264 V90 M252 14 H264 M252 22 H264" />
    <path class="fence-smoke" d="M258 -6 C252 -14 264 -20 256 -30 C250 -38 262 -44 256 -52" opacity="0.45" />
  </g>

  <!-- Box truck at the dock -->
  <g transform={`translate(1272 ${G - 46})`}>
    <rect x="0" y="0" width="62" height="34" rx="2" />
    <path d="M62 12 H76 L84 22 V34 H62 M66 15 H75 L80 22 H66 Z" />
    <circle cx="16" cy="38" r="7" />
    <circle cx="70" cy="38" r="7" />
  </g>

  <!-- Grain bins -->
  <g transform={`translate(1388 ${G - 74})`}>
    <path d="M0 74 V24 L20 8 L40 24 V74 M0 36 H40 M0 48 H40 M0 60 H40" />
    <path d="M46 74 V34 L62 20 L78 34 V74 M46 46 H78 M46 58 H78" />
    <path d="M20 8 V2 M62 20 V14" />
  </g>

  <!-- Fence, east end -->
  <path d={fenceB.posts} />
  <path d={fenceB.rails} opacity="0.7" />

  <!-- Power poles and lines -->
  {poles.map((x) => (
    <path d={`M${x} ${G} V${poleTop} M${x - 14} ${poleTop + 4} H${x + 14} M${x - 10} ${poleTop + 12} H${x + 10}`} />
  ))}
  {spans.flat().map((d) => <path d={d} opacity="0.75" />)}
  {animate && spans.map(([d], i) => (
    <path d={d} class="fence-signal" pathLength="100" style={`--d:${(i * 0.9).toFixed(1)}s`} />
  ))}
</svg>

<style>
  .fence-line {
    display: block;
    width: 100%;
  }

  .fence-signal {
    stroke: var(--color-accent);
    stroke-width: 2.6;
    stroke-dasharray: 8 92;
    stroke-dashoffset: 100;
    opacity: 0;
  }

  .fence-line--live .fence-signal {
    animation: fenceSignal 3.6s cubic-bezier(0.45, 0, 0.3, 1) var(--d, 0s) infinite;
  }

  @keyframes fenceSignal {
    0% { stroke-dashoffset: 100; opacity: 0; }
    10% { opacity: 1; }
    80% { opacity: 1; }
    100% { stroke-dashoffset: -8; opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fence-line--live .fence-signal {
      animation: none;
      opacity: 0;
    }
  }
</style>
