---
/* Why us, the small-business link, and the closing call to action. */
import { whyUs, smallBusiness, closing } from "../../data/home";
---

<section class="py-20 md:py-28 bg-cream">
  <div class="max-w-6xl mx-auto px-6 grid gap-14 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20 items-start">
    <div data-reveal>
      <span class="text-primary font-semibold text-sm uppercase tracking-wider">{whyUs.eyebrow}</span>
      <h2 class="mt-3 text-3xl md:text-5xl font-bold text-dark leading-[1.05] text-balance">{whyUs.title}</h2>
      <dl class="mt-10 space-y-8">
        {whyUs.points.map((pt) => (
          <div class="grid gap-2 sm:grid-cols-[13rem_1fr] sm:gap-8">
            <dt class="font-display text-xl font-bold text-dark leading-snug">{pt.name}</dt>
            <dd class="text-warm-700 leading-relaxed">{pt.text}</dd>
          </div>
        ))}
      </dl>
    </div>

    <figure class="lg:mt-24 relative" data-reveal="right">
      <span class="absolute -top-8 -left-2 font-accent italic text-[8rem] leading-none text-primary-light/40 select-none" aria-hidden="true">“</span>
      <blockquote class="relative font-accent italic text-3xl md:text-[2.1rem] leading-snug text-dark">
        {whyUs.quote.text}
      </blockquote>
      <figcaption class="mt-6 text-sm">
        <span class="font-semibold text-dark">{whyUs.quote.name}</span>
        <span class="text-warm-500"> · {whyUs.quote.business}</span>
      </figcaption>
    </figure>
  </div>
</section>

<div class="bg-white border-y border-warm-200">
  <p class="max-w-6xl mx-auto px-6 py-6 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6 text-warm-700">
    {smallBusiness.text}
    <a href={smallBusiness.link.href} class="sm:ml-auto font-semibold text-primary hover:text-primary-dark whitespace-nowrap underline underline-offset-4">
      {smallBusiness.link.label} <span aria-hidden="true">→</span>
    </a>
  </p>
</div>

<section class="relative py-24 md:py-32 bg-dark text-white overflow-hidden border-b border-white/10">
  <svg class="pointer-events-none absolute inset-0 w-full h-full opacity-[0.18]" viewBox="0 0 1200 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <path d="M-20 320 C 240 300, 380 120, 600 200 S 980 80, 1220 120" fill="none" stroke="#8eaf3e" stroke-width="1.5" stroke-dasharray="6 8" />
    <path d="M-20 80 C 200 140, 420 40, 640 110 S 1000 300, 1220 260" fill="none" stroke="#e6af2e" stroke-width="1.5" stroke-dasharray="6 8" />
  </svg>
  <div class="relative max-w-4xl mx-auto px-6" data-reveal>
    <h2 class="text-4xl md:text-6xl font-bold leading-[1.02] text-balance">{closing.title}</h2>
    <p class="mt-6 text-lg md:text-xl text-warm-300 max-w-2xl leading-relaxed">{closing.body}</p>
    <div class="mt-10 flex flex-col sm:flex-row gap-3">
      <a
        href={closing.primary.href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-7 py-4 bg-primary text-white font-semibold rounded-xl hover:bg-primary-light hover:text-dark transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        {closing.primary.label}
      </a>
      <a
        href={closing.secondary.href}
        class="inline-flex items-center justify-center px-7 py-4 border border-warm-600 text-warm-200 font-semibold rounded-xl hover:border-white hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        {closing.secondary.label}
      </a>
    </div>
  </div>
</section>
