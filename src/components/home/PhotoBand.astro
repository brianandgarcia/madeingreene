---
/* Big, edge-to-edge photographs: the "bigger images" pass. */
import { photoBand } from "../../data/home";
---

<section class="bg-white">
  <div class="grid md:grid-cols-[1.25fr_1fr]">
    {photoBand.images.map((img) => (
      <figure class="relative h-[22rem] md:h-[38rem] overflow-hidden">
        <img src={img.src} alt={img.alt} class="absolute inset-0 w-full h-full object-cover" loading="lazy" decoding="async" />
        <figcaption class="absolute left-5 bottom-5 rounded-full bg-white/90 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-dark">{img.place}</figcaption>
      </figure>
    ))}
  </div>
  <div class="max-w-6xl mx-auto px-6 py-12 md:py-16">
    <p class="max-w-3xl font-accent text-2xl md:text-[2rem] leading-snug text-dark">{photoBand.caption}</p>
  </div>
</section>
