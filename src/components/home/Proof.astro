---
/* One real integration, shown properly, beats a wall of logos. */
import { proof } from "../../data/home";
---

<section class="py-24 md:py-36 bg-white">
  <div class="max-w-[88rem] mx-auto px-6 lg:px-10 grid gap-12 lg:grid-cols-[1.45fr_0.75fr] lg:gap-20 items-center">
    <div class="relative order-2 lg:order-1" data-reveal="left">
      <div class="rounded-2xl overflow-hidden shadow-[0_40px_80px_-36px_rgba(12,12,12,0.45)] bg-warm-100">
        <div class="flex items-center gap-1.5 px-4 py-3 border-b border-warm-200 bg-warm-50" aria-hidden="true">
          <span class="w-2.5 h-2.5 rounded-full bg-warm-300"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-warm-300"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-warm-300"></span>
          <span class="ml-3 text-xs text-warm-500">echostationtn.com</span>
        </div>
        <img
          src={proof.image.src}
          alt={proof.image.alt}
          class="block w-full aspect-[16/11] object-cover object-top"
          loading="eager"
          decoding="async"
        />
      </div>
      <p class="mt-4 text-sm text-warm-500">{proof.note}</p>
    </div>

    <div class="order-1 lg:order-2" data-reveal>
      <span class="text-primary font-semibold text-sm uppercase tracking-wider">{proof.eyebrow}</span>
      <h2 class="mt-3 text-3xl md:text-5xl font-bold text-dark leading-[1.05]">{proof.title}</h2>
      <p class="mt-3 text-warm-500 font-medium">{proof.client}</p>
      {proof.body.map((p) => <p class="mt-5 text-lg text-warm-700 leading-relaxed">{p}</p>)}

      <div class="mt-10 grid grid-cols-2 gap-6">
        {proof.points.map((pt) => (
          <div>
            <p class="font-display text-5xl md:text-6xl font-black text-primary leading-none">{pt.value}</p>
            <p class="mt-2 text-sm text-warm-600 leading-snug">{pt.label}</p>
          </div>
        ))}
      </div>

      <a href={proof.link.href} class="mt-8 inline-flex items-center gap-2 font-semibold text-dark hover:text-primary transition-colors underline underline-offset-4 decoration-warm-300 hover:decoration-primary">
        {proof.link.label} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
