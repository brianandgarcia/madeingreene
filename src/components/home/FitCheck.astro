---
/* Who the work is for: drawn as the places they work, then the problems they'd recognise. */
import { fit } from "../../data/home";
import Pictogram from "../art/Pictogram.astro";
---

<section class="py-24 md:py-36 bg-hay">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-3xl" data-reveal>
      <span class="text-primary font-semibold text-sm uppercase tracking-wider">{fit.eyebrow}</span>
      <h2 class="mt-3 text-3xl md:text-6xl font-bold text-dark leading-[1.02] text-balance">{fit.title}</h2>
      <p class="mt-7 text-lg md:text-xl text-warm-600 leading-relaxed">{fit.body}</p>
    </div>

    <ul class="mt-16 md:mt-20 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-x-6 gap-y-12">
      {fit.who.map((w, i) => (
        <li class="flex flex-col items-start" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
          <Pictogram name={w.icon as any} class="w-16 h-16 md:w-20 md:h-20 text-primary-dark" />
          <span class="mt-4 font-display text-base md:text-lg font-bold leading-tight text-dark">{w.label}</span>
        </li>
      ))}
    </ul>

    <div class="mt-24 md:mt-32 grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div data-reveal>
        <p class="font-display text-2xl md:text-3xl font-bold leading-tight text-dark">{fit.signsTitle}</p>
        <p class="mt-8 pl-5 border-l-2 border-accent text-warm-700 leading-relaxed">
          {fit.aside}
        </p>
      </div>
      <ol class="space-y-8" data-reveal style="--reveal-delay: 120ms">
        {fit.signs.map((sign, i) => (
          <li class="flex gap-6">
            <span class="font-display text-3xl font-bold text-primary-light tabular-nums leading-none" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class="text-lg md:text-xl text-warm-800 leading-snug">{sign}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
