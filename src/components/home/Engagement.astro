---
/*
  The offer structure: three phases on one track. Prices and lengths are
  placeholders in src/data/home.ts until Brian sets them.
*/
import { engagement, smallBusinessNudge } from "../../data/home";
import { withPlaceholders } from "../../lib/placeholder";
---

<section id="engagement" class="py-24 md:py-36 bg-hay scroll-mt-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-2xl" data-reveal>
      <span class="text-primary font-semibold text-sm uppercase tracking-wider">{engagement.eyebrow}</span>
      <h2 class="mt-3 text-3xl md:text-5xl font-bold text-dark leading-[1.05] text-balance">{engagement.title}</h2>
      <p class="mt-5 text-lg text-warm-600 leading-relaxed">{engagement.body}</p>
    </div>

    <ol class="mt-16 md:mt-20 grid gap-14 lg:grid-cols-3 lg:gap-12">
      {engagement.phases.map((phase, i) => (
        <li data-reveal style={`--reveal-delay: ${i * 110}ms`}>
          <p class="font-display text-sm font-bold tracking-[0.14em] text-primary">PHASE {phase.number}</p>
          <h3 class="mt-2 text-2xl md:text-[1.7rem] font-bold text-dark">{phase.name}</h3>
          <dl class="mt-4 space-y-1.5 text-sm">
            <div class="flex gap-2"><dt class="text-warm-500 w-16 shrink-0">Length</dt><dd class="text-warm-800 font-medium" set:html={withPlaceholders(phase.length)} /></div>
            <div class="flex gap-2"><dt class="text-warm-500 w-16 shrink-0">Price</dt><dd class="text-warm-800 font-medium" set:html={withPlaceholders(phase.price)} /></div>
          </dl>
          <ul class="mt-5 space-y-2.5">
            {phase.items.map((item) => (
              <li class="flex gap-3 text-warm-700 leading-snug">
                <svg class="w-4 h-4 mt-1 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>

    <p class="mt-16 md:mt-20 pt-8 border-t border-warm-300 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6 text-lg text-warm-800">
      <span>{smallBusinessNudge.text}</span>
      <a href={smallBusinessNudge.link.href} class="sm:ml-auto shrink-0 font-semibold text-primary hover:text-primary-dark underline underline-offset-4 whitespace-nowrap">
        {smallBusinessNudge.link.label} <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>
