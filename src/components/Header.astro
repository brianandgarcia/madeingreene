---
interface Props {
  /*
    Header style at the top of the page:
      undefined — solid white with a border and shadow, always (the default)
      "light"   — transparent over a light hero, dark nav text
      "dark"    — transparent over a dark hero, white nav text

    In both overlay modes the header fades into the solid white bar as soon as
    the page scrolls. Pass "dark" for any page using PageHero, which is bg-dark —
    dark nav text on it would be unreadable.
  */
  overlay?: "light" | "dark";
}

const { overlay } = Astro.props;

// Normalize trailing slash so "/about/" matches a nav href of "/about".
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

// Top announcement bar — edit or set `show: false` to hide.
const announcement = {
  show: false,
  text: "Now booking new website projects for Greene County businesses.",
  linkLabel: "Get a Free Quote",
  href: "/contact",
};

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/services", label: "What We Offer" },
  { href: "/work", label: "Our Work" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
---

<header
  id="site-header"
  class:list={[
    "fixed top-0 left-0 right-0 z-50 border-b",
    "transition-[background-color,border-color,box-shadow] duration-300 ease-out",
    // The solid look. In overlay mode the CSS below overrides it until scroll.
    "bg-white border-warm-200 shadow-[0_8px_24px_rgba(0,0,0,0.06)]",
    overlay && "is-overlay",
    overlay === "dark" && "is-overlay-dark",
  ]}
>
  {announcement.show && (
    <div class="bg-primary text-white">
      <p class="max-w-[90rem] mx-auto px-6 sm:px-10 lg:px-12 xl:px-16 py-2 text-center text-xs sm:text-sm font-medium">
        {announcement.text}{" "}
        <a href={announcement.href} class="underline underline-offset-2 font-semibold hover:text-white/80 transition-colors">
          {announcement.linkLabel} →
        </a>
      </p>
    </div>
  )}

  <div class="max-w-[90rem] mx-auto">
    <nav class="px-6 sm:px-10 lg:px-12 xl:px-16 py-[1.125rem] flex items-center justify-between">
      <a href="/" class="flex items-center group" aria-label="Made in Greene — home">
        <img src="/made-in-greene-logo.svg" alt="Made in Greene" class="h-16 w-auto" />
      </a>

      <div class="hidden lg:flex items-center gap-5 xl:gap-8">
        <ul class="flex items-center gap-4 xl:gap-6">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "nav-item nav-link text-lg transition-colors hover:text-primary",
                currentPath === link.href
                  ? "is-active font-bold text-primary"
                  : "font-medium text-dark",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
        </ul>

        <a
          href="tel:+14232927294"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary text-white text-base font-semibold rounded-lg hover:bg-primary-dark transition-colors whitespace-nowrap"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h2.28a2 2 0 011.94 1.515l.7 2.8a2 2 0 01-.45 1.95l-1.27 1.27a16 16 0 006.32 6.32l1.27-1.27a2 2 0 011.95-.45l2.8.7A2 2 0 0121 17.72V20a2 2 0 01-2 2h-1C9.716 22 2 14.284 2 5V4" />
          </svg>
          Call/Text 423-292-7294
        </a>
      </div>

      <button
        id="mobile-menu-btn"
        class="nav-item lg:hidden p-2 text-dark hover:text-primary transition-colors"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </nav>

    <div id="mobile-menu" class="hidden lg:hidden border-t border-warm-200 bg-white">
      <div class="px-6 sm:px-10 lg:px-12 xl:px-16 py-4 space-y-3">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "block text-lg transition-colors hover:text-primary",
              currentPath === link.href ? "font-bold text-primary" : "font-medium text-dark",
            ]}
          >
            {link.label}
          </a>
        ))}
        <a
          href="tel:+14232927294"
          class="block w-full text-center px-5 py-2.5 bg-primary text-white text-base font-semibold rounded-lg hover:bg-primary-dark transition-colors"
        >
          Call/Text 423-292-7294
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /*
    Overlay mode: transparent at the top of the page, fading into the solid
    white bar once you scroll. `is-scrolled` is added by the script below.
    These need to out-specify the Tailwind utilities on the header, which the
    id + class selector does.
  */
  #site-header.is-overlay {
    background-color: transparent;
    border-bottom-color: transparent;
    box-shadow: none;
  }

  /* Solid again once scrolled — and while the mobile menu is open, so the
     open panel never hangs off a transparent bar. */
  #site-header.is-overlay.is-scrolled,
  #site-header.is-overlay.is-menu-open {
    background-color: #fff;
    border-bottom-color: var(--color-warm-200);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
  }

  /* Over a dark hero the nav has to invert until the white bar arrives. */
  #site-header.is-overlay-dark:not(.is-scrolled):not(.is-menu-open) .nav-item {
    color: #fff;
  }
  #site-header.is-overlay-dark:not(.is-scrolled):not(.is-menu-open) .nav-item.is-active {
    color: var(--color-primary-light);
  }
  #site-header.is-overlay-dark:not(.is-scrolled):not(.is-menu-open) .nav-item:hover {
    color: var(--color-primary-light);
  }

  /*
    Nav underline. It sweeps in from the left on hover and back out to the
    right on leave, so the line reads as travelling through the word rather
    than just appearing. The active page keeps its underline permanently.

    `currentColor` is deliberate: the link already turns green on hover and is
    green when active, and on a dark hero the overlay rules turn it white — the
    underline follows all three without needing its own colour rules.
  */
  .nav-link {
    position: relative;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.375rem;
    height: 2px;
    border-radius: 999px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .nav-link.is-active::after {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    #site-header {
      transition: none;
    }

    .nav-link::after {
      transition: none;
    }
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");

  btn?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
    header?.classList.toggle("is-menu-open", !menu?.classList.contains("hidden"));
  });

  // Only overlay headers change on scroll; everywhere else the bar is always solid.
  if (header?.classList.contains("is-overlay")) {
    const sync = () => header.classList.toggle("is-scrolled", window.scrollY > 8);
    sync(); // the page may already be scrolled on load (refresh, or a #hash link)
    window.addEventListener("scroll", sync, { passive: true });
  }
</script>
