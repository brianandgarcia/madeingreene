---
import type { Block, Cell } from "../data/proposals";

interface Props {
  block: Block;
}

const { block } = Astro.props;

/** Escapes HTML, then renders `**bold**` as <strong>. Keeps client copy plain-text-safe. */
function inline(text: string): string {
  const escaped = text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
  return escaped.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
}

const cellText = (cell: Cell) => (typeof cell === "string" ? cell : cell.text);
const cellBold = (cell: Cell) => typeof cell !== "string" && cell.bold === true;
const cellStrike = (cell: Cell) => (typeof cell === "string" ? undefined : cell.strike);

const calloutTone = {
  info: "border-primary/25 bg-primary/[0.06]",
  accent: "border-accent/40 bg-accent/10",
  warn: "border-warm-400/50 bg-warm-100",
} as const;
---

{block.type === "p" && (
  <p class="text-warm-700 leading-relaxed mb-4" set:html={inline(block.text)} />
)}

{block.type === "h3" && (
  <h3 class="font-display text-xl md:text-2xl font-bold text-primary-dark mt-9 mb-3">
    {block.text}
  </h3>
)}

{block.type === "list" && (
  <ul class="space-y-2.5 mb-5">
    {block.items.map((item) => (
      <li class="flex gap-3 text-warm-700 leading-relaxed">
        {block.style === "check" && (
          <svg class="w-5 h-5 shrink-0 mt-0.5 text-primary" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        )}
        {block.style === "x" && (
          <svg class="w-5 h-5 shrink-0 mt-0.5 text-warm-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        )}
        {(!block.style || block.style === "bullet") && (
          <span class="shrink-0 mt-[0.6em] w-1.5 h-1.5 rounded-full bg-primary" aria-hidden="true"></span>
        )}
        <span set:html={inline(item)} />
      </li>
    ))}
  </ul>
)}

{block.type === "table" && (
  <div class="my-6 overflow-x-auto rounded-xl border border-warm-200 print:overflow-visible">
    <table class="w-full min-w-[34rem] border-collapse text-left print:min-w-0">
      {block.head && (
        <thead>
          <tr class="bg-primary-dark text-white">
            {block.head.map((heading, i) => (
              <th
                scope="col"
                class:list={[
                  "px-4 py-3 text-sm font-semibold",
                  block.align?.[i] === "right" ? "text-right" : "text-left",
                ]}
              >
                {heading}
              </th>
            ))}
          </tr>
        </thead>
      )}
      <tbody>
        {block.rows.map((row, r) => (
          <tr
            class:list={[
              "align-top break-inside-avoid",
              row.emphasis ? "bg-primary/[0.08]" : r % 2 === 1 ? "bg-warm-50" : "bg-white",
              r > 0 && "border-t border-warm-200",
            ]}
          >
            {row.cells.map((cell, c) => (
              <td
                class:list={[
                  "px-4 py-3 text-warm-700 leading-relaxed",
                  block.align?.[c] === "right" && "text-right",
                  cellBold(cell) && "font-semibold text-warm-900",
                  row.emphasis && "text-primary-dark",
                ]}
              >
                {cellStrike(cell) && (
                  <span class="line-through text-warm-400 mr-2">{cellStrike(cell)}</span>
                )}
                <span set:html={inline(cellText(cell))} />
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}

{block.type === "steps" && (
  <ol class="space-y-5 my-6">
    {block.items.map((step, i) => (
      <li class="flex gap-4 break-inside-avoid">
        <span class="shrink-0 w-9 h-9 rounded-full bg-primary text-white font-semibold flex items-center justify-center text-sm print:border print:border-warm-400">
          {i + 1}
        </span>
        <div>
          <h4 class="font-semibold text-warm-900 mb-1">{step.title}</h4>
          <p class="text-warm-700 leading-relaxed" set:html={inline(step.text)} />
        </div>
      </li>
    ))}
  </ol>
)}

{block.type === "callout" && (
  <div
    class:list={[
      "my-6 rounded-xl border-l-4 px-5 py-4 break-inside-avoid",
      calloutTone[block.tone ?? "info"],
    ]}
  >
    {block.label && (
      <p class="font-semibold text-primary-dark mb-1" set:html={inline(block.label)} />
    )}
    <p class="text-warm-700 leading-relaxed" set:html={inline(block.text)} />
  </div>
)}

{block.type === "signature" && (
  <div class="sig-grid mt-8 grid gap-8 md:grid-cols-2 break-inside-avoid">
    {block.parties.map((party) => (
      <div class="break-inside-avoid rounded-xl border border-warm-200 bg-white p-6 print:border-warm-400">
        <h4 class="font-display text-lg font-bold text-primary-dark mb-5">{party.org}</h4>
        <dl class="space-y-5 text-sm">
          <div>
            <dt class="font-semibold text-warm-600 mb-3">Authorized Representative</dt>
            <dd class="border-b border-warm-400 h-7"></dd>
          </div>
          <div>
            <dt class="font-semibold text-warm-600 mb-3">Printed Name</dt>
            {party.printedName ? (
              <dd class="border-b border-warm-400 h-7 text-warm-900">{party.printedName}</dd>
            ) : (
              <dd class="border-b border-warm-400 h-7"></dd>
            )}
          </div>
          <div>
            <dt class="font-semibold text-warm-600 mb-3">Title</dt>
            {party.title ? (
              <dd class="border-b border-warm-400 h-7 text-warm-900">{party.title}</dd>
            ) : (
              <dd class="border-b border-warm-400 h-7"></dd>
            )}
          </div>
          <div>
            <dt class="font-semibold text-warm-600 mb-3">Date</dt>
            <dd class="border-b border-warm-400 h-7"></dd>
          </div>
        </dl>
      </div>
    ))}
  </div>
)}
