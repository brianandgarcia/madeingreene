---
import Layout from "../../layouts/Layout.astro";
import CTA from "../../components/CTA.astro";
import {
  publishedPosts,
  formatPostDate,
  readingTime,
  type BlogPost,
} from "../../data/posts";

export function getStaticPaths() {
  return publishedPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const minutes = readingTime(post);

// More posts to read, excluding the current one.
const more = publishedPosts.filter((p) => p.slug !== post.slug).slice(0, 2);

const siteUrl = Astro.site ?? new URL("https://madeingreene.com");
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.excerpt,
  datePublished: post.date,
  author: { "@type": "Organization", name: "Made in Greene" },
  publisher: {
    "@type": "Organization",
    name: "Made in Greene",
    logo: {
      "@type": "ImageObject",
      url: new URL("/apple-touch-icon.png", siteUrl).href,
    },
  },
  mainEntityOfPage: canonical,
  ...(post.cover ? { image: new URL(post.cover, siteUrl).href } : {}),
};
---

<Layout title={post.title} description={post.excerpt}>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(articleSchema)}
    slot="head"
  />

  <!-- Header -->
  <section class="pt-32 md:pt-40 pb-10 bg-warm-100">
    <div class="max-w-3xl mx-auto px-6">
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-warm-500 hover:text-primary transition-colors mb-6"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        The Blog
      </a>

      <span class="inline-flex items-center rounded-full bg-primary/10 px-3 py-1 text-[11px] font-semibold text-primary-dark uppercase tracking-wide mb-4">
        {post.category}
      </span>

      <h1 class="text-3xl md:text-5xl font-extrabold text-dark leading-[1.08] tracking-tight mb-5">
        {post.title}
      </h1>

      <div class="flex items-center gap-3 text-sm text-warm-500">
        {post.author && <span>By {post.author}</span>}
        {post.author && <span class="w-1 h-1 rounded-full bg-warm-300"></span>}
        <span>{formatPostDate(post.date)}</span>
        <span class="w-1 h-1 rounded-full bg-warm-300"></span>
        <span>{minutes} min read</span>
      </div>
    </div>
  </section>

  {post.cover && (
    <section class="bg-warm-100 pb-12 md:pb-16">
      <div class="max-w-4xl mx-auto px-6">
        <div class="rounded-2xl overflow-hidden ring-1 ring-warm-200 shadow-xl shadow-dark/10">
          <img src={post.cover} alt="" loading="eager" class="w-full" />
        </div>
      </div>
    </section>
  )}

  <!-- Article body -->
  <article class="py-14 md:py-20 bg-cream">
    <div class="max-w-3xl mx-auto px-6 space-y-6">
      {post.body.map((block) => {
        switch (block.type) {
          case "heading":
            return (
              <h2 class="text-2xl md:text-3xl font-bold text-dark leading-snug pt-6 first:pt-0">
                {block.text}
              </h2>
            );
          case "paragraph":
            return (
              <p
                class="text-lg text-warm-700 leading-relaxed [&_a]:text-primary [&_a]:font-medium [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:text-primary-dark"
                set:html={block.text}
              />
            );
          case "list":
            return block.ordered ? (
              <ol class="space-y-3 pl-1">
                {block.items.map((item, i) => (
                  <li class="flex items-start gap-3 text-lg text-warm-700 leading-relaxed">
                    <span class="shrink-0 mt-0.5 w-6 h-6 rounded-full bg-primary/10 text-primary-dark text-sm font-bold flex items-center justify-center">
                      {i + 1}
                    </span>
                    <span class="[&_a]:text-primary [&_a]:font-medium [&_a]:underline" set:html={item} />
                  </li>
                ))}
              </ol>
            ) : (
              <ul class="space-y-3">
                {block.items.map((item) => (
                  <li class="flex items-start gap-3 text-lg text-warm-700 leading-relaxed">
                    <svg class="w-5 h-5 text-primary shrink-0 mt-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="[&_a]:text-primary [&_a]:font-medium [&_a]:underline" set:html={item} />
                  </li>
                ))}
              </ul>
            );
          case "callout":
            return (
              <div class="my-2 rounded-2xl border-l-4 border-primary bg-primary/5 p-6">
                {block.title && (
                  <div class="font-bold text-dark mb-1.5">{block.title}</div>
                )}
                <p class="text-warm-700 leading-relaxed [&_a]:text-primary [&_a]:underline" set:html={block.text} />
              </div>
            );
          case "quote":
            return (
              <blockquote class="my-4 border-l-4 border-warm-300 pl-6">
                <p class="text-xl md:text-2xl font-medium text-dark italic leading-relaxed">
                  “{block.text}”
                </p>
                {block.cite && (
                  <cite class="block mt-3 text-sm text-warm-500 not-italic">— {block.cite}</cite>
                )}
              </blockquote>
            );
          case "image":
            return (
              <figure class="my-4">
                <div class="rounded-2xl overflow-hidden ring-1 ring-warm-200 shadow-sm">
                  <img src={block.src} alt={block.alt} loading="lazy" class="w-full" />
                </div>
                {block.caption && (
                  <figcaption class="mt-3 text-sm text-warm-500 text-center">{block.caption}</figcaption>
                )}
              </figure>
            );
        }
      })}
    </div>
  </article>

  <!-- More posts -->
  {more.length > 0 && (
    <section class="py-16 md:py-20 bg-warm-100 border-t border-warm-200">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="text-2xl font-bold text-dark mb-8">Keep reading</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {more.map((p) => (
            <a
              href={`/blog/${p.slug}`}
              class="group flex flex-col bg-white rounded-2xl p-6 border border-warm-200 hover:border-primary/40 hover:shadow-lg hover:shadow-primary/5 transition-all"
            >
              <span class="inline-flex self-start items-center rounded-full bg-primary/10 px-3 py-1 text-[11px] font-semibold text-primary-dark uppercase tracking-wide mb-3">
                {p.category}
              </span>
              <h3 class="text-lg font-bold text-dark leading-snug mb-2 group-hover:text-primary transition-colors">
                {p.title}
              </h3>
              <p class="text-warm-600 text-sm leading-relaxed">{p.excerpt}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTA />
</Layout>
