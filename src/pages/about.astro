---
/*
  About page, formal rewrite. Copy lives in src/data/about.ts.
*/
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { seo, header, overview, leadership, principles, approach } from "../data/about";
import { closing } from "../data/home";
import { withPlaceholders } from "../lib/placeholder";
---

<Layout title={seo.title} description={seo.description} headerOverlay="dark">
  <PageHero
    eyebrow={header.eyebrow}
    title={header.title}
    subtitle={header.subtitle}
    image="/about-hero-bg.jpg"
    imagePosition="object-[28%_center] sm:object-center"
  />

  <!-- The studio -->
  <section class="py-24 md:py-36 bg-cream">
    <div class="max-w-6xl mx-auto px-6 grid gap-12 lg:grid-cols-[1.2fr_0.8fr] lg:gap-20">
      <div>
        <span class="text-primary font-semibold text-sm uppercase tracking-wider">{overview.eyebrow}</span>
        <h2 class="mt-3 text-3xl md:text-[2.6rem] font-bold text-dark leading-[1.1] text-balance">{overview.title}</h2>
        <div class="mt-8 space-y-5 text-lg text-warm-700 leading-relaxed">
          {overview.body.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <dl class="self-start border-t-2 border-dark lg:mt-10">
        {overview.facts.map((f) => (
          <div class="grid grid-cols-[7.5rem_1fr] gap-4 py-4 border-b border-warm-300">
            <dt class="text-sm font-semibold uppercase tracking-wider text-warm-500 pt-0.5">{f.label}</dt>
            <dd class="text-dark font-medium" set:html={withPlaceholders(f.value)} />
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Leadership -->
  <section class="py-24 md:py-36 bg-white border-y border-warm-200">
    <div class="max-w-6xl mx-auto px-6 grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20 items-start">
      {leadership.image.src ? (
        <img
          src={leadership.image.src}
          alt={leadership.image.alt}
          class="w-full aspect-[4/5] object-cover rounded-2xl border border-warm-200"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div
          class="w-full aspect-[4/5] rounded-2xl border-2 border-dashed border-warm-300 bg-warm-100 flex flex-col items-center justify-center text-center p-8"
          role="img"
          aria-label={leadership.image.alt}
        >
          <svg class="w-10 h-10 text-warm-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
            <circle cx="12" cy="13" r="3" stroke-width="1.5" />
          </svg>
          <span class="mt-4 ph-tag"><span class="ph-tag__label">Photo</span> {leadership.image.shot}</span>
        </div>
      )}

      <div>
        <span class="text-primary font-semibold text-sm uppercase tracking-wider">{leadership.eyebrow}</span>
        <h2 class="mt-3 text-3xl md:text-[2.6rem] font-bold text-dark leading-[1.1]">{leadership.title}</h2>
        <div class="mt-10 space-y-10">
          {leadership.people.map((p) => (
            <article class="border-l-2 border-primary-light pl-6">
              <h3 class="text-2xl font-bold text-dark" set:html={withPlaceholders(p.name)} />
              <p class="mt-1 text-sm font-semibold uppercase tracking-wider text-primary" set:html={withPlaceholders(p.role)} />
              <p class="mt-4 text-lg text-warm-700 leading-relaxed">{p.bio}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="py-24 md:py-36 bg-cream">
    <div class="max-w-6xl mx-auto px-6">
      <span class="text-primary font-semibold text-sm uppercase tracking-wider">{principles.eyebrow}</span>
      <h2 class="mt-3 text-3xl md:text-[2.6rem] font-bold text-dark leading-[1.1]">{principles.title}</h2>
      <ol class="mt-12 grid gap-x-16 md:grid-cols-2 border-t border-warm-300">
        {principles.items.map((item, i) => (
          <li class="flex gap-6 py-8 border-b border-warm-300">
            <span class="font-display text-2xl font-bold text-primary-light leading-none pt-1 tabular-nums" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div>
              <h3 class="text-xl font-bold text-dark">{item.title}</h3>
              <p class="mt-2 text-warm-700 leading-relaxed">{item.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Approach -->
  <section class="py-24 md:py-36 bg-primary-dark text-white">
    <div class="max-w-6xl mx-auto px-6 grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div>
        <span class="text-primary-light font-semibold text-sm uppercase tracking-wider">{approach.eyebrow}</span>
        <h2 class="mt-3 text-3xl md:text-[2.6rem] font-bold leading-[1.1]">{approach.title}</h2>
      </div>
      <dl class="divide-y divide-white/15 border-y border-white/15">
        {approach.items.map((item) => (
          <div class="grid gap-2 py-6 sm:grid-cols-[11rem_1fr] sm:gap-8">
            <dt class="font-display text-xl font-bold text-accent">{item.title}</dt>
            <dd class="text-white/80 leading-relaxed">{item.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Close -->
  <section class="py-20 md:py-24 bg-dark text-white border-b border-white/10">
    <div class="max-w-6xl mx-auto px-6 flex flex-col lg:flex-row lg:items-end gap-8 lg:gap-16">
      <div class="max-w-2xl">
        <h2 class="text-3xl md:text-5xl font-bold leading-[1.05]">{closing.title}</h2>
        <p class="mt-5 text-lg text-warm-300 leading-relaxed">{closing.body}</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 lg:ml-auto shrink-0">
        <a
          href={closing.primary.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-7 py-4 bg-primary text-white font-semibold rounded-xl hover:bg-primary-light hover:text-dark transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          {closing.primary.label}
        </a>
        <a
          href={closing.secondary.href}
          class="inline-flex items-center justify-center px-7 py-4 border border-warm-600 text-warm-200 font-semibold rounded-xl hover:border-white hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          {closing.secondary.label}
        </a>
      </div>
    </div>
  </section>
</Layout>
