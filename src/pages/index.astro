---
/*
  Homepage, mid-market redesign: custom websites, integrations and automation
  for established businesses. All copy is in src/data/home.ts.
  The previous small-business homepage sections (Hero, WhyWebsite, GreeneQuote,
  ServicesOverview, PricingPreview, etc.) are untouched in src/components/.
*/
import Layout from "../layouts/Layout.astro";
import SystemsHero from "../components/home/SystemsHero.astro";
import FitCheck from "../components/home/FitCheck.astro";
import Capabilities from "../components/home/Capabilities.astro";
import Proof from "../components/home/Proof.astro";
import PhotoBand from "../components/home/PhotoBand.astro";
import Engagement from "../components/home/Engagement.astro";
import WhyLocal from "../components/home/WhyLocal.astro";
import GettingFound from "../components/GettingFound.astro";
import { seo } from "../data/home";
---

<Layout title={seo.title} description={seo.description} headerOverlay="light">
  <SystemsHero />
  <FitCheck />
  <Capabilities />
  <Proof />
  <PhotoBand />
  <Engagement />
  <GettingFound variant="teaser" id="marketing" />
  <WhyLocal />
</Layout>
