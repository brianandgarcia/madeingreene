---
/*
  What We Offer, mid-market redesign. Copy lives in src/data/services.ts; the
  engagement phases and the three kinds of work are shared with the homepage.
*/
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Engagement from "../components/home/Engagement.astro";
import Capabilities from "../components/home/Capabilities.astro";
import { seo, header, jumps, buildDetail, proofLine, included, found, terms, faqs, smallBusinessBand } from "../data/services";
import { closing } from "../data/home";
import { withPlaceholders } from "../lib/placeholder";
---

<Layout title={seo.title} description={seo.description} headerOverlay="dark">
  <PageHero
    eyebrow={header.eyebrow}
    title={header.title}
    subtitle={header.subtitle}
    image="/echo-station-photo-shoot.jpg"
    imagePosition="object-[30%_center] md:object-center"
  />

  <!-- Jump links: the page is long, so say what's on it up front -->
  <nav aria-label="On this page" class="bg-white border-b border-warm-200">
    <ul class="max-w-6xl mx-auto px-6 py-4 flex gap-x-6 gap-y-2 flex-wrap text-sm">
      {jumps.map((j) => (
        <li>
          <a href={j.href} class="font-semibold text-warm-700 hover:text-primary underline-offset-4 hover:underline">{j.label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <Engagement />

  <Capabilities id="build" fit={buildDetail} />

  <div class="bg-white border-b border-warm-200">
    <p class="max-w-6xl mx-auto px-6 py-6 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6 text-warm-700">
      <span class="inline-flex items-center gap-3">
        <span class="w-2 h-2 rounded-full bg-primary-light shrink-0" aria-hidden="true"></span>
        {proofLine.text}
      </span>
      <a href={proofLine.link.href} class="sm:ml-auto font-semibold text-primary hover:text-primary-dark whitespace-nowrap underline underline-offset-4">
        {proofLine.link.label} <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>

  <!-- Included in every project -->
  <section id="included" class="py-24 md:py-36 bg-cream scroll-mt-24">
    <div class="max-w-6xl mx-auto px-6">
      <span class="text-primary font-semibold text-sm uppercase tracking-wider">{included.eyebrow}</span>
      <h2 class="mt-3 text-3xl md:text-5xl font-bold text-dark leading-[1.05] max-w-2xl">{included.title}</h2>
      <dl class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 border-t border-l border-warm-300">
        {included.items.map((item) => (
          <div class="p-6 border-r border-b border-warm-300">
            <dt class="font-display text-lg font-bold text-dark">{item.name}</dt>
            <dd class="mt-2 text-warm-700 leading-relaxed">{item.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Getting found: Google Business Profile and Google Ads -->
  <section id="found" class="py-24 md:py-36 bg-primary-dark text-white scroll-mt-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl">
        <span class="text-primary-light font-semibold text-sm uppercase tracking-wider">{found.eyebrow}</span>
        <h2 class="mt-3 text-3xl md:text-5xl font-bold leading-[1.05]">{found.title}</h2>
        <p class="mt-5 text-lg text-white/75 leading-relaxed">{found.body}</p>
      </div>
      <div class="mt-12 border-t border-white/15">
        {found.services.map((svc) => (
          <article class="grid gap-3 py-8 border-b border-white/15 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] md:gap-12">
            <div>
              <h3 class="text-xl md:text-2xl font-bold">{svc.name}</h3>
              <p class="mt-2 font-semibold text-accent leading-snug">{svc.price}</p>
            </div>
            <p class="text-white/85 leading-relaxed">{svc.text}</p>
          </article>
        ))}
      </div>
      <p class="mt-8 pl-4 border-l-2 border-accent text-white/85 leading-relaxed max-w-3xl">{found.note}</p>
    </div>
  </section>

  <!-- Pricing structure -->
  <section class="py-24 md:py-36 bg-white border-y border-warm-200">
    <div class="max-w-6xl mx-auto px-6 grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-20 items-start">
      <div>
        <span class="text-primary font-semibold text-sm uppercase tracking-wider">{terms.eyebrow}</span>
        <h2 class="mt-3 text-3xl md:text-5xl font-bold text-dark leading-[1.05]">{terms.title}</h2>
        {terms.body.map((p) => <p class="mt-6 text-lg text-warm-700 leading-relaxed">{p}</p>)}
        <h3 class="mt-10 text-lg font-bold text-dark">{terms.lineItemsTitle}</h3>
        <dl class="mt-3 border-t border-warm-300">
          {terms.lineItems.map((li) => (
            <div class="grid grid-cols-[1fr_auto] gap-x-6 py-3 border-b border-warm-200">
              <dt class="font-semibold text-dark">{li.label}</dt>
              <dd class="font-semibold text-primary-dark text-right whitespace-nowrap">{li.price}</dd>
              <dd class="col-span-2 text-sm text-warm-600">{li.detail}</dd>
            </div>
          ))}
        </dl>
      </div>
      <dl class="border-t-2 border-dark">
        {terms.rows.map((r) => (
          <div class="grid gap-1 sm:grid-cols-[12rem_1fr] sm:gap-6 py-5 border-b border-warm-300">
            <dt class="font-display font-bold text-dark">{r.label}</dt>
            <dd class="text-warm-800" set:html={withPlaceholders(r.value)} />
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="py-24 md:py-36 bg-cream scroll-mt-24">
    <div class="max-w-4xl mx-auto px-6">
      <span class="text-primary font-semibold text-sm uppercase tracking-wider">Questions</span>
      <h2 class="mt-3 text-3xl md:text-5xl font-bold text-dark leading-[1.05]">What people ask before a discovery call.</h2>
      <div class="mt-10 border-t border-warm-300">
        {faqs.map((faq) => (
          <details class="faq group border-b border-warm-300">
            <summary class="flex items-center justify-between gap-6 py-5 cursor-pointer list-none font-display text-lg md:text-xl font-bold text-dark hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
              {faq.question}
              <span class="faq-icon shrink-0 w-7 h-7 rounded-full border border-warm-300 grid place-items-center text-primary" aria-hidden="true">+</span>
            </summary>
            <p class="pb-6 pr-12 text-warm-700 leading-relaxed">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Small business packages now have their own page -->
  <section id="packages" class="py-14 md:py-16 bg-warm-100 border-t border-warm-200 scroll-mt-24">
    <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row md:items-center gap-6 md:gap-12">
      <div class="max-w-2xl">
        <span class="text-primary font-semibold text-sm uppercase tracking-wider">{smallBusinessBand.eyebrow}</span>
        <h2 class="mt-2 text-2xl md:text-3xl font-bold text-dark leading-[1.1]">{smallBusinessBand.title}</h2>
        <p class="mt-3 text-warm-700 leading-relaxed">{smallBusinessBand.body}</p>
      </div>
      <a href={smallBusinessBand.cta.href} class="md:ml-auto shrink-0 inline-flex items-center gap-2 px-6 py-3.5 bg-dark text-white font-semibold rounded-xl hover:bg-primary transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
        {smallBusinessBand.cta.label} <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- Close -->
  <section class="py-20 md:py-24 bg-dark text-white border-b border-white/10">
    <div class="max-w-6xl mx-auto px-6 flex flex-col lg:flex-row lg:items-end gap-8 lg:gap-16">
      <div class="max-w-2xl">
        <h2 class="text-3xl md:text-5xl font-bold leading-[1.05]">{closing.title}</h2>
        <p class="mt-5 text-lg text-warm-300 leading-relaxed">{closing.body}</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 lg:ml-auto shrink-0">
        <a
          href={closing.primary.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-7 py-4 bg-primary text-white font-semibold rounded-xl hover:bg-primary-light hover:text-dark transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          {closing.primary.label}
        </a>
        <a
          href={closing.secondary.href}
          class="inline-flex items-center justify-center px-7 py-4 border border-warm-600 text-warm-200 font-semibold rounded-xl hover:border-white hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          {closing.secondary.label}
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    transition: transform 200ms ease-out;
  }

  .faq[open] .faq-icon {
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-icon {
      transition: none;
    }
  }
</style>
